# Gemini API Key (Server-side) & Optional Backup Failover Keys
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
# Or comma-separated list of failover keys:
# GEMINI_API_KEYS=key1,key2,key3

# Claude writes, doctors and fact-checks scripts (Frontier pipeline on the Scripts page).
# Without it the pipeline uses Gemini.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5)
ANTHROPIC_MODEL=

# Optional external service providers
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
PEXELS_API_KEY=
HUGGINGFACE_API_KEY=
AI33_API_KEY=
AI33_BASE_URL=

# Self-hosted VoiceStudio backend (see docs/voicestudio.md)
# Base URL of the server, e.g. https://voice.example.com (no trailing /v1)
VOICESTUDIO_URL=
# The OMNIVOICE_API_KEY the VoiceStudio container was started with
VOICESTUDIO_API_KEY=
